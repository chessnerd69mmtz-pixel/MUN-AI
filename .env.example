# Local AI is the default. No cloud API key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Optional server-side cloud keys. The homepage API mode can also supply
# keys per request without writing them to the repo or .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_WRITING_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
UNLIMITLESS_API_KEY=
UNLIMITLESS_BASE_URL=https://api.vireonix.ai/v1
UNLIMITLESS_MODEL=auto
